{
  "name": "time-space-cognition",
  "version": "1.0.0",
  "private": true,
  "description": "Personal academic website, built with Hugo and Tailwind CSS",
  "scripts": {
    "css": "tailwindcss -i ./assets/css/main.css -o ./assets/css/tailwind.css --minify",
    "css:watch": "tailwindcss -i ./assets/css/main.css -o ./assets/css/tailwind.css --watch",
    "build": "npm run css && hugo --gc --minify",
    "serve": "npm run css && hugo server --disableFastRender",
    "clean": "rm -rf public resources assets/css/tailwind.css"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  }
}
